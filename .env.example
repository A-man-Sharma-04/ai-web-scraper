# Copy this file to ".env" (in the project root, next to package.json) and fill it in.
# Get a FREE API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional — the model used for summaries. Defaults to openai/gpt-oss-120b.
# List the models your key can use: curl -H "Authorization: Bearer $GROQ_API_KEY" \
#   https://api.groq.com/openai/v1/models | grep -o '"id":"[^"]*"'
GROQ_MODEL=openai/gpt-oss-120b

# Optional — port for the Express backend in local development. Defaults to 3001.
PORT=3001
