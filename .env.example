# Copy this file to ".env" (in the project root, next to package.json) and fill it in.
# Get a FREE API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional — the model used for summaries. Defaults to llama-3.3-70b-versatile.
GROQ_MODEL=llama-3.3-70b-versatile

# Optional — port for the Express backend in local development. Defaults to 3001.
PORT=3001
